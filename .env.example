# Optional when commands run inside the ssl-proxy checkout.
# ROTATOR_REPO_ROOT=/absolute/path/to/ssl-proxy
ROTATOR_HEALTH_URL=http://127.0.0.1:3002/health
ROTATOR_HEALTH_TIMEOUT_MS=5000
ROTATOR_INCLUDE_PUBLIC_KEY=true
ROTATOR_STATE_DIR=secrets/wg-rotation
ROTATOR_PEERS=peer1,peer2
ROTATOR_MIGRATION_TIMEOUT_SECS=86400
ROTATOR_HANDSHAKE_GRACE_SECS=600
ROTATOR_FRONTDOOR_CONFIG_PATH=secrets/wg-rotation/frontdoor/wg-udp-frontdoor.toml
ROTATOR_NEXT_ADMIN_PORT=3012

WAHA_IMAGE=devlikeapro/waha
WAHA_PLATFORM=linux/amd64
WAHA_HOST_PORT=3006
WAHA_BASE_URL=http://127.0.0.1:3006
WAHA_SESSION=default
WAHA_CHAT_ID=12132132130@c.us
WAHA_NO_API_KEY=False
WAHA_API_KEY=<generated by scripts/gen-secrets env>
WAHA_API_KEY_FILE=
